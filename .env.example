# Telegram Bot
BOT_TOKEN=your_bot_token_here
ADMIN_ID=your_telegram_id_here
WEBHOOK_URL=https://your-service.onrender.com

# Database
DATABASE_URL=postgresql://user:password@host:5432/database
PGSSLMODE=true

# Security — MUST be long random values in production (no weak defaults!)
# Generate e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
ADMIN_TOKEN=change_me_to_a_long_random_string

# CORS: comma-separated allowed origins. Defaults to WEBHOOK_URL if unset.
ALLOWED_ORIGINS=

# Telegram WebApp auth
# Set to "false" ONLY for an emergency rollback (re-opens the vulnerability).
TELEGRAM_AUTH_REQUIRED=true
# Optional initData freshness window in seconds (0 = signature only, no expiry).
TELEGRAM_INITDATA_MAX_AGE=0

# Server
PORT=10000
NODE_ENV=production